+// Column-scoped properties, named like Iceberg's other column-scoped properties
+// (write.metadata.metrics.column.<name>): the suffix is the exact name of a
+// top-level primitive field. A column level requires a column codec.
+constexpr std::string_view kColumnCompressionPrefix =
+    "write.parquet.compression-codec.column.";
+constexpr std::string_view kColumnCompressionLevelPrefix =
+    "write.parquet.compression-level.column.";
+
+Status CheckCompressionLevel(std::string_view compression_name,
+                             ::arrow::Compression::type compression, int32_t level) {
+  ICEBERG_PRECHECK(::arrow::util::Codec::SupportsCompressionLevel(compression),
+                   "Parquet compression codec {} does not accept a level",
+                   compression_name);
+  auto minimum = ::arrow::util::Codec::MinimumCompressionLevel(compression);
+  auto maximum = ::arrow::util::Codec::MaximumCompressionLevel(compression);
+  ICEBERG_PRECHECK(minimum.ok() && maximum.ok() && level >= *minimum && level <= *maximum,
+                   "Parquet compression level {} is outside the range of codec {}",
+                   level, compression_name);
+  return {};
+}
+
+Status ApplyColumnCompression(const WriterProperties& properties, const Schema& schema,
+                              ::parquet::WriterProperties::Builder& builder) {
+  std::unordered_map<std::string, std::string> codecs;
+  std::unordered_map<std::string, std::string> levels;
+  for (const auto& [key, value] : properties.configs()) {
+    if (key.starts_with(kColumnCompressionPrefix)) {
+      codecs.emplace(key.substr(kColumnCompressionPrefix.size()), value);
+    } else if (key.starts_with(kColumnCompressionLevelPrefix)) {
+      levels.emplace(key.substr(kColumnCompressionLevelPrefix.size()), value);
+    }
+  }
+  for (const auto& [column, level] : levels) {
+    ICEBERG_PRECHECK(codecs.contains(column),
+                     "Parquet compression level of column {} requires a column codec",
+                     column);
+  }
+  for (const auto& [column, compression_name] : codecs) {
+    const auto& fields = schema.fields();
+    const auto field = std::ranges::find_if(
+        fields, [&](const SchemaField& candidate) { return candidate.name() == column; });
+    ICEBERG_PRECHECK(field != fields.end() && field->type()->is_primitive(),
+                     "Parquet column compression names unknown column {}", column);
+    ICEBERG_ASSIGN_OR_RAISE(auto compression, ParseCompressionName(compression_name));
+    ICEBERG_PRECHECK(::arrow::util::Codec::IsAvailable(compression),
+                     "Parquet compression codec {} is not available in the current build",
+                     compression_name);
+    // Arrow keys column properties by dot string; a top-level column's path is
+    // its field name.
+    builder.compression(column, compression);
+    const auto level = levels.find(column);
+    if (level == levels.end()) {
+      // Levels are codec specific: never inherit the file-level one.
+      builder.compression_level(column, ::arrow::util::kUseDefaultCompressionLevel);
+      continue;
+    }
+    ICEBERG_ASSIGN_OR_RAISE(auto parsed, StringUtils::ParseNumber<int32_t>(level->second));
+    ICEBERG_RETURN_UNEXPECTED(CheckCompressionLevel(compression_name, compression, parsed));
+    builder.compression_level(column, parsed);
+  }
+  return {};
+}
+
 }  // namespace
 
